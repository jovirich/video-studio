# African History Studio — environment template
# Copy to `.env` and fill locally. `.env` is gitignored and must never be committed.
# No key in this file is required to run `studio_ops validate` — validation is offline
# by design so that CI never depends on a vendor being up.

# ---- Repository ----
STUDIO_ROOT=.
STUDIO_DEFAULT_LINE=ng-nigeria
STUDIO_LOG_LEVEL=INFO

# ---- Asset store (media lives here, not in git) ----
# Supported drivers: local | s3 | r2 | gcs
ASSET_STORE_DRIVER=local
ASSET_STORE_LOCAL_PATH=../ahs-assets
ASSET_STORE_BUCKET=
ASSET_STORE_REGION=
ASSET_STORE_ACCESS_KEY_ID=
ASSET_STORE_SECRET_ACCESS_KEY=
ASSET_STORE_ENDPOINT=

# ---- Generation adapters (all optional; adapters are stubs until wired) ----
# Text / reasoning
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Image
MIDJOURNEY_SESSION=
FLUX_API_KEY=
STABILITY_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=

# Video
RUNWAY_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
LUMA_API_KEY=
PIKA_API_KEY=

# Audio / voice / music
ELEVENLABS_API_KEY=
RESEMBLE_API_KEY=
SUNO_API_KEY=

# Restoration / upscale
TOPAZ_API_KEY=
MAGNIFIC_API_KEY=

# ---- Publishing (leave blank until distribution is configured) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Cost guards ----
# Hard ceiling per episode in USD; adapters refuse to run past this.
GENERATION_BUDGET_USD_PER_EPISODE=0
GENERATION_DRY_RUN=true
