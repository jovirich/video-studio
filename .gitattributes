# Normalise line endings — this repo is authored on Windows and CI runs on Linux.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.srt   text eol=lf
*.vtt   text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf

# Binary — never diff, never merge
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.tif   binary
*.exr   binary
*.mp4   binary
*.mov   binary
*.mxf   binary
*.wav   binary
*.aif   binary
*.mp3   binary
*.flac  binary
*.psd   binary
*.ai    binary
*.otf   binary
*.ttf   binary
*.cube  binary
*.prproj binary
*.drp   binary

# Large media, if ever tracked, goes through LFS. Prefer the object store instead.
# *.mov filter=lfs diff=lfs merge=lfs -text

# Treat these as documentation for GitHub language stats
*.md linguist-documentation
