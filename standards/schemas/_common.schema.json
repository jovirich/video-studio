{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://african-history-studio.local/schemas/_common.schema.json",
  "title": "Common definitions",
  "description": "Shared field definitions referenced by every other schema. Never validated directly.",
  "$defs": {
    "recordStatus": {
      "type": "string",
      "enum": ["draft", "review", "locked", "superseded", "retracted"],
      "description": "See standards/id_system.md § Lifecycle states."
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lineCode": {
      "type": "string",
      "pattern": "^([a-z]{2}-[a-z-]+|studio)$",
      "examples": ["ng-nigeria", "gh-ghana", "studio"]
    },
    "episodeCode": {
      "type": "string",
      "pattern": "^S\\d{2}E\\d{2}$"
    },
    "roleSlug": {
      "type": "string",
      "enum": [
        "showrunner", "research-lead", "story-producer", "visual-director",
        "audio-lead", "rights-and-clearances", "cultural-advisor",
        "pipeline-engineer", "editor", "composer", "translator", "advisor"
      ]
    },
    "sourceId":  { "type": "string", "pattern": "^SRC-([A-Z]{2}|STUDIO)-\\d{4}$" },
    "claimId":   { "type": "string", "pattern": "^CLM-[A-Z]{2}-\\d{4}$" },
    "characterId": { "type": "string", "pattern": "^CHR-[A-Z]{2}-\\d{4}$" },
    "locationId":  { "type": "string", "pattern": "^LOC-[A-Z]{2}-\\d{4}$" },
    "orgId":     { "type": "string", "pattern": "^ORG-[A-Z]{2}-\\d{4}$" },
    "objectId":  { "type": "string", "pattern": "^OBJ-[A-Z]{2}-\\d{4}$" },
    "eventId":   { "type": "string", "pattern": "^EVT-[A-Z]{2}-\\d{4}$" },
    "questionId":{ "type": "string", "pattern": "^QST-[A-Z]{2}-\\d{4}$" },
    "shotId":    { "type": "string", "pattern": "^SHT-[A-Z]{2}-S\\d{2}E\\d{2}-\\d{4}$" },
    "sequenceId":{ "type": "string", "pattern": "^SEQ-[A-Z]{2}-S\\d{2}E\\d{2}-\\d{3}$" },
    "promptCardId": { "type": "string", "pattern": "^PC-([A-Z]{2}-S\\d{2}E\\d{2}|STUDIO)-\\d{4}$" },
    "assetId":   { "type": "string", "pattern": "^AST-[A-Z]{2}-S\\d{2}E\\d{2}-\\d{4}$" },
    "clearanceId": { "type": "string", "pattern": "^CLR-([A-Z]{2}|STUDIO)-\\d{4}$" },
    "advisoryId":{ "type": "string", "pattern": "^ADV-[A-Z]{2}-\\d{4}$" },
    "styleAnchorId": { "type": "string", "pattern": "^STA-([A-Z]{2}|STUDIO)-\\d{4}$" },

    "sourceTier": {
      "type": "string",
      "enum": ["T1", "T2", "T3", "T4", "T5"],
      "description": "T1 primary/archival, T2 peer-reviewed secondary, T3 reputable general, T4 oral testimony, T5 never citable. See bible/02."
    },
    "confidenceRegister": {
      "type": "string",
      "enum": ["established", "probable", "contested", "inferred", "traditional", "unknown"],
      "description": "See bible/01 § Registers of certainty."
    },
    "provenanceClass": {
      "type": "string",
      "enum": ["archival", "contemporary", "artefact", "reconstruction", "interpretive", "graphic", "text_on_screen"],
      "description": "See bible/04 § Categories of image."
    },
    "sensitivity": {
      "type": "string",
      "enum": ["none", "review-required", "held"],
      "description": "'held' places an advisory hold; advisory_ref becomes required. See bible/07 §4."
    },
    "gateStatus": {
      "type": "string",
      "enum": ["not-required", "pending", "in-review", "signed", "blocked"]
    },
    "signature": {
      "type": "object",
      "description": "A human sign-off. Absence of a signature is never inferred from anything else.",
      "properties": {
        "role":   { "$ref": "#/$defs/roleSlug" },
        "person": { "type": "string" },
        "date":   { "$ref": "#/$defs/isoDate" },
        "note":   { "type": "string" }
      },
      "required": ["role", "person", "date"],
      "additionalProperties": false
    },
    "tbdString": {
      "description": "A string that may be the literal 'TBD' or 'TBD — <reason>' while status is draft or review. Illegal at status locked; enforced by studio_ops, not by this schema.",
      "type": "string"
    },
    "dateRange": {
      "type": "object",
      "description": "Historical dating. Always a range, because point dates are usually false precision.",
      "properties": {
        "earliest": { "type": "string" },
        "latest":   { "type": "string" },
        "display":  { "type": "string", "description": "How this is spoken on screen." },
        "calendar": { "type": "string", "description": "Gregorian, Hijri, regnal, relative, etc." },
        "basis":    { "type": "string", "description": "How the dating was arrived at." },
        "confidence": { "$ref": "#/$defs/confidenceRegister" },
        "claims":   { "type": "array", "items": { "$ref": "#/$defs/claimId" } }
      },
      "required": ["display", "confidence"],
      "additionalProperties": false
    },
    "baseRecord": {
      "type": "object",
      "properties": {
        "id":       { "type": "string" },
        "type":     { "type": "string" },
        "line":     { "$ref": "#/$defs/lineCode" },
        "title":    { "type": "string" },
        "status":   { "$ref": "#/$defs/recordStatus" },
        "version":  { "$ref": "#/$defs/semver" },
        "updated":  { "$ref": "#/$defs/isoDate" },
        "owners":   { "type": "array", "items": { "$ref": "#/$defs/roleSlug" }, "minItems": 1 },
        "sensitivity":  { "$ref": "#/$defs/sensitivity" },
        "advisory_ref": { "$ref": "#/$defs/advisoryId" },
        "superseded_by": { "type": "string" },
        "retraction_reason": { "type": "string" }
      },
      "required": ["id", "type", "line", "title", "status", "version", "updated", "owners"],
      "allOf": [
        {
          "if": { "properties": { "sensitivity": { "const": "held" } }, "required": ["sensitivity"] },
          "then": { "required": ["advisory_ref"] }
        },
        {
          "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
          "then": { "required": ["superseded_by"] }
        },
        {
          "if": { "properties": { "status": { "const": "retracted" } }, "required": ["status"] },
          "then": { "required": ["retraction_reason"] }
        }
      ]
    }
  }
}
